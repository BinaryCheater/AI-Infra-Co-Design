// The template's program (paper Listing 1) as a CUDA kernel: for each block, prefetch P tiles into S
// rotating shared-memory slots, then per k-phase load tile p+P, leading barrier, compute from slot
// p mod S, optional trailing barrier. FP32 FMA; cp.async loads when the row strides are 16 B aligned.
#include <cuda_runtime.h>

#define TM {{TM}}
#define TN {{TN}}
#define TK {{TK}}
#define SLOTS {{S}}
#define PREFETCH {{P}}
#define TRAILING_BARRIER {{BETA}}
#define GRID_CEIL {{GRID_CEIL}}          // 1: ceil(M/TM) x ceil(N/TN); 0: floor (drops the tail tiles)
#define GUARDED {{GUARDED}}             // 1: tail elements guarded by index < extent
#define THREADS 256
#define TX 16
#define TY 16
#define RM (TM / TY)
#define RN (TN / TX)

__device__ __forceinline__ void cp_async16(void* smem, const void* gmem, int src_bytes) {
  unsigned s = (unsigned)__cvta_generic_to_shared(smem);
  asm volatile("cp.async.cg.shared.global [%0], [%1], 16, %2;\n" :: "r"(s), "l"(gmem), "r"(src_bytes));
}
__device__ __forceinline__ void cp_async_commit() { asm volatile("cp.async.commit_group;\n"); }
template <int N> __device__ __forceinline__ void cp_async_wait() { asm volatile("cp.async.wait_group %0;\n" :: "n"(N)); }

// load k-tile u (A[TM x TK] and B[TK x TN]) into slot `slot`
__device__ __forceinline__ void load_tile(float* As, float* Bs, const float* __restrict__ A, const float* __restrict__ B,
                                          int M, int N, int K, int row0, int col0, int u, int use_async) {
  const int k0 = u * TK;
  if (use_async) {
    // A: TM rows x TK cols, 16 B chunks along k
    for (int c = threadIdx.x; c < TM * TK / 4; c += THREADS) {
      int r = c / (TK / 4), kc = (c % (TK / 4)) * 4;
      int gr = row0 + r, gk = k0 + kc;
      int bytes = (GUARDED && (gr >= M || gk >= K)) ? 0 : (GUARDED ? min(16, max(0, (K - gk) * 4)) : 16);
      const float* src = (bytes > 0) ? A + (size_t)gr * K + gk : A;
      cp_async16(As + r * TK + kc, src, bytes);
    }
    // B: TK rows x TN cols, 16 B chunks along n
    for (int c = threadIdx.x; c < TK * TN / 4; c += THREADS) {
      int r = c / (TN / 4), nc = (c % (TN / 4)) * 4;
      int gk = k0 + r, gn = col0 + nc;
      int bytes = (GUARDED && (gk >= K || gn >= N)) ? 0 : (GUARDED ? min(16, max(0, (N - gn) * 4)) : 16);
      const float* src = (bytes > 0) ? B + (size_t)gk * N + gn : B;
      cp_async16(Bs + r * TN + nc, src, bytes);
    }
    cp_async_commit();
  } else {
    for (int c = threadIdx.x; c < TM * TK; c += THREADS) {
      int r = c / TK, kk = c % TK; int gr = row0 + r, gk = k0 + kk;
      As[r * TK + kk] = (GUARDED && (gr >= M || gk >= K)) ? 0.f : A[(size_t)gr * K + gk];
    }
    for (int c = threadIdx.x; c < TK * TN; c += THREADS) {
      int r = c / TN, nn = c % TN; int gk = k0 + r, gn = col0 + nn;
      Bs[r * TN + nn] = (GUARDED && (gk >= K || gn >= N)) ? 0.f : B[(size_t)gk * N + gn];
    }
  }
}

template <int PENDING> __device__ __forceinline__ void wait_pending(int use_async) { if (use_async) cp_async_wait<PENDING>(); }

extern "C" __global__ void __launch_bounds__(THREADS)
smem_tiling_gemm(const float* __restrict__ A, const float* __restrict__ B, float* __restrict__ C, int M, int N, int K, int use_async,
                 int amp_warp, long long amp_cycles) {   // race amplifier: warp amp_warp spins amp_cycles before each compute (-1: off)
  extern __shared__ float smem[];
  float* As = smem;                           // SLOTS x TM x TK
  float* Bs = smem + SLOTS * TM * TK;         // SLOTS x TK x TN
  const int row0 = blockIdx.y * TM, col0 = blockIdx.x * TN;
  const int tx = threadIdx.x % TX, ty = threadIdx.x / TX;
  const int KT = (K + TK - 1) / TK;
  float acc[RM][RN];
  for (int i = 0; i < RM; i++) for (int j = 0; j < RN; j++) acc[i][j] = 0.f;

  for (int u = 0; u < PREFETCH && u < KT; u++)
    load_tile(As + (u % SLOTS) * TM * TK, Bs + (u % SLOTS) * TK * TN, A, B, M, N, K, row0, col0, u, use_async);

  for (int p = 0; p < KT; p++) {
    int issued = 0;
    if (PREFETCH == 0) { load_tile(As + (p % SLOTS) * TM * TK, Bs + (p % SLOTS) * TK * TN, A, B, M, N, K, row0, col0, p, use_async); }
    else if (p + PREFETCH < KT) { int u = p + PREFETCH; load_tile(As + (u % SLOTS) * TM * TK, Bs + (u % SLOTS) * TK * TN, A, B, M, N, K, row0, col0, u, use_async); issued = 1; }
    // tile p must be complete: allow only the groups issued after it to stay pending
    int pending = PREFETCH == 0 ? 0 : min(PREFETCH, KT - 1 - p);
    if (pending >= 2) wait_pending<2>(use_async); else if (pending == 1) wait_pending<1>(use_async); else wait_pending<0>(use_async);
    __syncthreads();                                                   // leading barrier
    if (amp_warp >= 0 && (int)(threadIdx.x / 32) == amp_warp) { long long t0 = clock64(); while (clock64() - t0 < amp_cycles) { } }
    const float* a = As + (p % SLOTS) * TM * TK; const float* b = Bs + (p % SLOTS) * TK * TN;
#pragma unroll 4
    for (int kk = 0; kk < TK; kk++) {
      float af[RM], bf[RN];
      for (int i = 0; i < RM; i++) af[i] = a[(ty + i * TY) * TK + kk];
      for (int j = 0; j < RN; j++) bf[j] = b[kk * TN + tx + j * TX];
      for (int i = 0; i < RM; i++) for (int j = 0; j < RN; j++) acc[i][j] = fmaf(af[i], bf[j], acc[i][j]);
    }
#if TRAILING_BARRIER
    __syncthreads();                                                   // trailing barrier
#endif
    (void)issued;
  }
  for (int i = 0; i < RM; i++) for (int j = 0; j < RN; j++) {
    int r = row0 + ty + i * TY, c = col0 + tx + j * TX;
    if (!GUARDED || (r < M && c < N)) C[(size_t)r * N + c] = acc[i][j];
  }
}

// launch geometry for the harness
extern "C" void smem_tiling_geometry(int M, int N, int K, int* gx, int* gy, int* threads, int* smem_bytes, int* use_async) {
  *gx = GRID_CEIL ? (N + TN - 1) / TN : N / TN;
  *gy = GRID_CEIL ? (M + TM - 1) / TM : M / TM;
  *threads = THREADS;
  *smem_bytes = SLOTS * (TM * TK + TK * TN) * (int)sizeof(float);
  *use_async = (K % 4 == 0 && N % 4 == 0 && TK % 4 == 0 && TN % 4 == 0) ? 1 : 0;
}
